{
  "manifest_version": 3,
  "name": "Fill.ai",
  "version": "0.2.1",
  "description": "Learns who you are once, then reads any form and fills it for you. Never submits on its own.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Fill.ai: fill this form (Alt+Shift+F)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage", "scripting", "unlimitedStorage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Open Fill.ai on this page"
    }
  },
  "minimum_chrome_version": "116"
}
