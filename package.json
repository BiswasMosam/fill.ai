{
  "name": "fill-ai",
  "version": "0.1.0",
  "private": true,
  "description": "An AI that learns who you are once, then reads any form and fills it for you.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "build:test": "node build.mjs --test",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "e2e": "node build.mjs --test && node test/e2e/run.mjs",
    "smoke": "node build.mjs && node test/e2e/smoke-prod.mjs"
  },
  "author": "Mosam Biswas",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0"
  }
}
